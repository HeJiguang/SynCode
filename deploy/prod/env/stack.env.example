# Stack-level deploy variables used by the local-manager CD flow.
STACK_NAME=onlineoj-prod
STACK_IMAGE_TAG=sha-REPLACE_ME
STACK_REGISTRY=local-build

WEB_IMAGE=syncode-web:sha-REPLACE_ME
APP_IMAGE=syncode-app:sha-REPLACE_ME
ADMIN_IMAGE=syncode-admin:sha-REPLACE_ME

RUNTIME_IMAGE=oj-runtime:sha-REPLACE_ME
GATEWAY_IMAGE=oj-gateway:sha-REPLACE_ME
SYSTEM_IMAGE=oj-system:sha-REPLACE_ME
FRIEND_IMAGE=oj-friend:sha-REPLACE_ME
JOB_IMAGE=oj-job:sha-REPLACE_ME
JUDGE_IMAGE=oj-judge:sha-REPLACE_ME
SANDBOX_IMAGE=syncode/oj-sandbox-multilang:1.0.0
AGENT_IMAGE=oj-agent:sha-REPLACE_ME
HERMES_IMAGE=syncode-hermes:sha-REPLACE_ME
HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
HERMES_MODEL=deepseek-chat
HERMES_DEEPSEEK_API_KEY=replace-with-deepseek-key

SYNCODE_HERMES_API_KEY=replace-with-hermes-api-key
SYNCODE_HERMES_SESSION_SECRET=replace-with-session-scope-secret
SYNCODE_HERMES_PROVISION_KEY=replace-with-profile-provision-key
SYNCODE_AGENT_RUNTIME_GATEWAY_KEY=replace-with-runtime-gateway-key
SYNCODE_MCP_SERVICE_KEY=replace-with-mcp-service-key
SYNCODE_RUNTIME_MAX_RUNS_PER_USER=2
SYNCODE_RUNTIME_MAX_RUNS_PER_RUNTIME=20
SYNCODE_RUNTIME_RUN_STALE_SECONDS=3600
SYNCODE_RUNTIME_AUTO_FAILOVER=true
SYNCODE_LEARNING_PROFILE_POLL_SECONDS=900
SYNCODE_LEARNING_PROFILE_BATCH_SIZE=500
SYNCODE_LEARNING_PROFILE_MAX_RUNS_PER_SWEEP=5

PUBLIC_DOMAIN=oj.example.com
MANAGER_PUBLIC_IP=101.96.200.76
WORKER_PUBLIC_IP=101.96.200.77
WORKER_SSH_HOST=101.96.200.77
WORKER_SSH_USER=root
WORKER_SSH_PORT=22
WORKER_IMAGE_LIST=oj-agent:sha-REPLACE_ME oj-judge:sha-REPLACE_ME

DOCKER_SOCKET_PATH=/var/run/docker.sock
JUDGE_HOST_USER_CODE_DIR=/app/user-code
JUDGE_HOST_USER_CODE_POOL_DIR=/app/user-code-pool

MANAGER_CONSTRAINT=node.role==manager
WORKER_CONSTRAINT=node.hostname==iv-yeivf9a8sgobzsynlbka

# Use `compact` with `deploy/prod/swarm/stack-compact.yml`, otherwise keep `microservices`.
DEPLOYMENT_MODE=microservices
BACKEND_NETWORK=syncode-backend

# Disabled by default in production.
NEXT_PUBLIC_SYNCODE_DEMO_LOGIN=0
SYNCODE_DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_SYNCODE_TEST_LOGIN=0
SYNCODE_TEST_LOGIN_ENABLED=false
SYNCODE_TEST_STUDENT_EMAIL=student@syncode.test
SYNCODE_TEST_TEACHER_EMAIL=teacher@syncode.test
SYNCODE_TEST_TEACHER_ACCOUNT=admin
