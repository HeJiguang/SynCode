# Runtime-level env examples.
# 这些变量更偏向运行期，由 stack 注入容器；业务细项仍建议放到 Nacos。

SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai

NACOS_ENABLED=true
NACOS_CONFIG_ENABLED=true
NACOS_DISCOVERY_ENABLED=true
NACOS_SERVER_ADDR=http://101.96.200.76:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-nacos-password
NACOS_NAMESPACE=replace-with-prod-namespace
NACOS_GROUP=DEFAULT_GROUP

SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_DOCKER_IMAGE=syncode/oj-sandbox-multilang:1.0.0
SANDBOX_DOCKER_NAME_PREFIX=oj-sandbox-core
SANDBOX_DOCKER_VOLUME=/usr/share/java
SANDBOX_EXECUTION_MODE=pool
SANDBOX_DOCKER_POOL_SIZE=4
SANDBOX_LIMIT_MEMORY=268435456
SANDBOX_LIMIT_MEMORY_SWAP=268435456
SANDBOX_COMPILE_TIMEOUT_SECONDS=10
SANDBOX_TOTAL_TIMEOUT_SECONDS=60
JUDGE_SCHEDULER_WORKERS=0
JUDGE_CONSUMER_PREFETCH=0
JUDGE_REALTIME_BURST=4
JUDGE_QUEUE_CAPACITY_MULTIPLIER=1
JUDGE_LOCK_LEASE_SECONDS=30
JUDGE_LOCK_RENEW_INTERVAL_SECONDS=10

MYSQL_HOST=101.96.200.76
MYSQL_DATABASE=bitoj_dev
MYSQL_APP_USER=replace-with-mysql-app-user
MYSQL_PASSWORD=replace-with-mysql-password

REDIS_HOST=101.96.200.76
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password

RABBITMQ_HOST=101.96.200.76
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=replace-with-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password

MAIL_IS_SEND=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=replace-with-smtp-mailbox
MAIL_PASSWORD=replace-with-smtp-authorization-code
MAIL_FROM=replace-with-smtp-mailbox
MAIL_SUBJECT=SynCode 登录验证码
MAIL_AUTH=true
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false
MAIL_SSL_ENABLE=true
MAIL_SSL_PROTOCOLS=TLSv1.2
MAIL_CODE_EXPIRATION=5
MAIL_SEND_LIMIT=3

OJ_AGENT_NACOS_CONFIG_ENABLED=false
OJ_AGENT_NACOS_SERVER_ADDR=http://101.96.200.76:8848
OJ_AGENT_NACOS_NAMESPACE=replace-with-prod-namespace
OJ_AGENT_NACOS_GROUP=DEFAULT_GROUP
OJ_AGENT_NACOS_CONFIG_DATA_ID=oj-agent-prod.yaml
OJ_AGENT_NACOS_USERNAME=nacos
OJ_AGENT_NACOS_PASSWORD=replace-with-nacos-password
OJ_AGENT_NACOS_ENABLED=true
OJ_AGENT_NACOS_SERVICE_NAME=oj-agent
OJ_AGENT_NACOS_PORT=8015
OJ_AGENT_LLM_PROVIDER=openai_compatible
OJ_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
OJ_AGENT_LLM_API_KEY=replace-with-deepseek-key
OJ_AGENT_CHAT_MODEL=deepseek-chat
OJ_AGENT_TRAINING_MODEL=deepseek-chat
OJ_AGENT_RUNTIME_PROVIDER=hermes
OJ_AGENT_RUNTIME_FALLBACK_TO_DIRECT=true
OJ_AGENT_HERMES_BASE_URL=http://replace-with-private-hermes-host:8642
OJ_AGENT_HERMES_API_KEY=replace-with-a-strong-sidecar-key
OJ_AGENT_HERMES_PROVIDER=deepseek
OJ_AGENT_HERMES_CHAT_MODEL=deepseek-chat
OJ_AGENT_HERMES_TRAINING_MODEL=deepseek-chat
OJ_AGENT_ALLOW_INSECURE_USER_ID_BODY=false
OJ_AGENT_CONVERSATION_SOFT_TOKEN_LIMIT=16000
OJ_AGENT_CONVERSATION_HARD_TOKEN_LIMIT=22000
OJ_AGENT_USER_MAX_ACTIVE_RUNS=3
OJ_AGENT_USER_RUN_RATE_LIMIT_PER_MINUTE=20
OJ_AGENT_ACTIVE_RUN_STALE_SECONDS=300
OJ_AGENT_GLOBAL_MAX_CONCURRENT_RUNS=16
OJ_AGENT_RUN_ADMISSION_WAIT_SECONDS=15

NEXT_PUBLIC_SITE_URL=https://oj.example.com
