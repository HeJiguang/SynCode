STACK_NAME=onlineoj-test
STACK_IMAGE_TAG=test-local
STACK_REGISTRY=local-build

WEB_IMAGE=syncode/web:test-local
APP_IMAGE=syncode/app:test-local
ADMIN_IMAGE=syncode/admin:test-local
RUNTIME_IMAGE=syncode/oj-runtime:test-local
JUDGE_IMAGE=syncode/oj-judge:test-local
AGENT_IMAGE=syncode/oj-agent:test-local

DOCKER_SOCKET_PATH=/var/run/docker.sock
JUDGE_HOST_USER_CODE_DIR=/app/user-code
JUDGE_HOST_USER_CODE_POOL_DIR=/app/user-code-pool

MANAGER_CONSTRAINT=node.role==manager
DEPLOYMENT_MODE=compact
BACKEND_NETWORK=syncode-test-backend

# Test-only guest experience. Keep both values aligned.
NEXT_PUBLIC_SYNCODE_DEMO_LOGIN=1
SYNCODE_DEMO_LOGIN_ENABLED=true
