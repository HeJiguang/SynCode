# Local-first example for running oj-agent without Nacos.
# Keep Nacos disabled locally. Cloud deployment can override these through env vars.
OJ_AGENT_PORT=8016

OJ_AGENT_NACOS_CONFIG_ENABLED=false
OJ_AGENT_NACOS_SERVER_ADDR=
OJ_AGENT_NACOS_NAMESPACE=
OJ_AGENT_NACOS_GROUP=DEFAULT_GROUP
OJ_AGENT_NACOS_CONFIG_DATA_ID=oj-agent-local.yaml
OJ_AGENT_NACOS_USERNAME=nacos
OJ_AGENT_NACOS_PASSWORD=

OJ_AGENT_NACOS_ENABLED=false
OJ_AGENT_NACOS_SERVICE_NAME=oj-agent
OJ_AGENT_NACOS_PORT=8016
OJ_AGENT_NACOS_IP=127.0.0.1

# Agent runtime. Hermes is the primary runtime; direct remains available as a fallback.
OJ_AGENT_RUNTIME_PROVIDER=hermes
OJ_AGENT_RUNTIME_FALLBACK_TO_DIRECT=true
OJ_AGENT_HERMES_BASE_URL=http://127.0.0.1:8642
OJ_AGENT_HERMES_API_KEY=replace-with-a-strong-sidecar-key
OJ_AGENT_HERMES_PROVIDER=deepseek
OJ_AGENT_HERMES_CHAT_MODEL=deepseek-v4-pro
OJ_AGENT_HERMES_TRAINING_MODEL=deepseek-v4-pro
OJ_AGENT_HERMES_REQUEST_TIMEOUT_SECONDS=10
OJ_AGENT_HERMES_RUN_TIMEOUT_SECONDS=90
OJ_AGENT_HERMES_POLL_INTERVAL_SECONDS=0.25

# Direct DeepSeek configuration is used by the fallback runtime.
OJ_AGENT_LLM_PROVIDER=openai_compatible
OJ_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
OJ_AGENT_LLM_API_KEY=replace-with-your-key
OJ_AGENT_CHAT_MODEL=deepseek-v4-pro
OJ_AGENT_TRAINING_MODEL=deepseek-v4-pro

# Local pressure-test defaults: keep optional retrieval pieces off unless needed.
OJ_AGENT_RAG_ENABLED=false
OJ_AGENT_RAG_DOC_GLOBS=
OJ_AGENT_RAG_TOP_K=3
OJ_AGENT_RAG_MAX_SNIPPET_CHARS=420

OJ_AGENT_QDRANT_ENABLED=false
OJ_AGENT_QDRANT_URL=http://127.0.0.1:6333
OJ_AGENT_QDRANT_API_KEY=
OJ_AGENT_QDRANT_COLLECTION=oj-agent-knowledge
OJ_AGENT_QDRANT_TOP_K=3
OJ_AGENT_QDRANT_CHUNK_SIZE=240

OJ_AGENT_GATEWAY_USER_ID_HEADER=X-User-Id
OJ_AGENT_AUTH_BASE_URL=http://127.0.0.1:19090
OJ_AGENT_ALLOW_INSECURE_USER_ID_BODY=false

# Chat persistence and product-level context budget. With no MySQL variables,
# local development uses runtime-artifacts/syncode-agent.sqlite3.
OJ_AGENT_DATABASE_URL=
OJ_AGENT_CONVERSATION_SOFT_TOKEN_LIMIT=16000
OJ_AGENT_CONVERSATION_HARD_TOKEN_LIMIT=22000

# Multi-user run admission and resource isolation. Set a limit to 0 to disable it.
OJ_AGENT_USER_MAX_ACTIVE_RUNS=3
OJ_AGENT_USER_RUN_RATE_LIMIT_PER_MINUTE=20
OJ_AGENT_ACTIVE_RUN_STALE_SECONDS=300
OJ_AGENT_GLOBAL_MAX_CONCURRENT_RUNS=16
OJ_AGENT_RUN_ADMISSION_WAIT_SECONDS=15

# Runtime persistence defaults to local files + in-memory stores.
OJ_AGENT_RUNTIME_DATA_DIR=
OJ_AGENT_TRACE_STORE=memory
OJ_AGENT_QUERY_LEDGER_STORE=memory
OJ_AGENT_EVALUATION_STORE=memory
